# Upstream services. Read server-side only — never exposed to the browser.
# Start them from the repo root before `npm run dev` (see frontend/README.md).
STT_BASE_URL=http://localhost:8001
MATCHER_BASE_URL=http://localhost:8002

# Supabase, for the operational routes (consent, plans, count records, auditor
# actions, Oracle export). SERVER-ONLY: the service-role key bypasses RLS, so
# the names are deliberately NOT `PUBLIC_`-prefixed — Astro inlines every
# PUBLIC_ variable into the browser bundle.
#
# MERGE NOTE: reconcile with the parallel `redis-catalogue-cache` change if it
# introduces its own Supabase variable names.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
