---
/**
 * V1 `review` — the live three-pane auditor view (REQ-AUD-1..5).
 *
 * WHY THIS PAGE DOES NOT USE `AuditorLayout.astro`: that layout exposes four
 * fixed grid slots (rail / bodegas / registros / detalle) as siblings of the
 * grid. The review view is ONE island — selection, filters, actions, trace and
 * the export gate are a single connected state tree — so it cannot be split
 * across three sibling slots without hoisting its state into a store and
 * shipping three islands. The layout's own shell contract (lang, charset,
 * single Google Fonts call, skip link, the 1024px notice, visible auditor
 * scrollbars) is reproduced here instead, and `cierre.astro` / `base.astro`
 * still use `AuditorLayout` because they are genuinely static.
 *
 * Styles are `is:global` on purpose: the class names they target are rendered
 * by the Preact island, which Astro's scoped-style hashing never sees.
 */
import '../../styles/global.css';

import AuditorRail from '../../components/auditor/AuditorRail.astro';
import { AuditorReview } from '../../components/auditor/AuditorReview';
/*
 * The RECORDS are live (`GET /api/auditor/records`, task 5.6). The bodega pane
 * and the auditor's own name still come from the design seed: no route lists a
 * plan's warehouses or names the signed-in auditor yet, and inventing either in
 * the island would hide that. They are passed in from here so the island itself
 * imports no fixture at all.
 */
import { AUDITOR_EYEBROW, AUDITOR_NAME, AUDITOR_WAREHOUSES } from '../../fixtures/auditorSeed';

export const prerender = true;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0067b1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Revisión · Auditor</title>

    {/* D12: same single Google Fonts CDN call as the two layouts. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300,0,0&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>

    <p class="notice">Usa una tablet o un computador para la revisión</p>

    <div class="shell" id="contenido">
      <nav class="shell__rail" aria-label="Secciones del auditor">
        <AuditorRail active="review" />
      </nav>

      <AuditorReview
        client:load
        warehouses={AUDITOR_WAREHOUSES}
        auditorName={AUDITOR_NAME}
        eyebrow={AUDITOR_EYEBROW}
      />
    </div>
  </body>
</html>

<style is:global>
  .notice {
    display: none;
    place-content: center;
    min-height: 100dvh;
    padding: var(--sp-6);
    text-align: center;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--text-soft-2);
    background: var(--page);
  }

  @media (max-width: 1023.98px) {
    .notice {
      display: grid;
    }

    .shell {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .shell {
      display: grid;
      grid-template-columns: var(--auditor-rail) 1fr;
      height: 100dvh;
      background: var(--app-bg-auditor);
    }
  }

  .shell__rail {
    background: var(--brand-blue);
    overflow-y: auto;
  }

  /* ------------------------------------------------------------- island */

  .review {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    height: 100dvh;
  }

  .review__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-6);
    border-bottom: 1px solid var(--border-5);
    background: var(--surface);
  }

  .review__eyebrow {
    margin: 0;
    color: var(--text-faint);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .review__title {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .review__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .review__panes {
    display: grid;
    grid-template-columns: var(--auditor-warehouses) 1fr var(--auditor-detail);
    min-height: 0;
  }

  .review__bodegas,
  .review__detalle {
    padding: var(--sp-4);
    background: var(--surface);
    overflow-y: auto;
  }

  .review__bodegas {
    border-right: 1px solid var(--border-5);
  }

  .review__detalle {
    border-left: 1px solid var(--border-5);
  }

  .review__registros {
    min-width: 0;
    padding: var(--sp-4) var(--sp-5);
    overflow-y: auto;
  }

  .review__bodegas::-webkit-scrollbar,
  .review__registros::-webkit-scrollbar,
  .review__detalle::-webkit-scrollbar {
    width: 6px;
  }

  .review__bodegas::-webkit-scrollbar-thumb,
  .review__registros::-webkit-scrollbar-thumb,
  .review__detalle::-webkit-scrollbar-thumb {
    background: var(--border-4);
    border-radius: var(--r-pill);
  }

  /* -------------------------------------------------------------- pills */

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-pill);
    font-size: 12.5px;
    font-weight: 700;
  }

  .pill--warn {
    background: var(--warn-bg);
    color: var(--warn-text);
  }

  .pill--ok {
    background: var(--ok-bg);
    color: var(--ok);
  }

  .pill__icon,
  .btn__icon {
    font-family: var(--font-icon);
    font-size: 18px;
  }

  /* ------------------------------------------------------------ buttons */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    height: var(--h-auditor-secondary);
    padding: 0 var(--sp-5);
    border-radius: var(--r-btn);
    font-size: 13.5px;
    font-weight: 700;
  }

  .btn--primary {
    background: var(--brand-blue);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--brand-blue-hover);
  }

  .btn--secondary {
    border: 1.5px solid var(--border-4);
    color: var(--text-muted);
  }

  .btn--recount:hover {
    border-color: var(--warn);
    color: var(--warn);
  }

  .btn--export {
    height: var(--h-auditor-primary);
  }

  /* The gate is visual AND semantic: see the comment in AuditorReview.tsx. */
  .btn--export[aria-disabled='true'] {
    background: var(--disabled-bg-3);
    color: var(--disabled-fg-2);
    cursor: not-allowed;
  }

  /* --------------------------------------------------------- warehouses */

  .pane__title {
    margin: 0 0 var(--sp-3);
    color: var(--text-faint-2);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wlist,
  .rlist,
  .signed {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wrow {
    display: grid;
    gap: var(--sp-2);
    width: 100%;
    padding: var(--sp-3);
    border: 1px solid transparent;
    border-radius: var(--r-card);
    text-align: left;
  }

  .wrow--selected {
    border-color: var(--brand-blue);
    background: var(--surface-pale-blue-2);
  }

  .wrow__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .wrow__name {
    font-size: 13.5px;
    font-weight: 700;
  }

  .wrow__icon {
    font-family: var(--font-icon);
    font-size: 18px;
    color: var(--text-faint-3);
  }

  .bar {
    display: block;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--border-6);
    overflow: hidden;
  }

  .bar__fill {
    display: block;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--border-4);
  }

  .bar--cerrada .bar__fill {
    background: var(--brand-blue);
  }

  .bar--en-curso .bar__fill {
    background: var(--brand-yellow);
  }

  .wrow__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    color: var(--text-faint-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-meta);
  }

  .wrow__state {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  /* -------------------------------------------------------- record list */

  .chips {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
  }

  .chip {
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--border-3);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--text-soft);
    font-size: 12.5px;
    font-weight: 700;
  }

  .chip--on {
    border-color: var(--brand-blue);
    background: var(--brand-blue);
    color: #fff;
  }

  .chips__count {
    margin: 0 0 0 auto;
    color: var(--text-faint-3);
    font-size: 12px;
  }

  .rrow {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border-2);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-row);
    text-align: left;
  }

  .rrow--alert {
    border-color: var(--warn-border-3);
  }

  .rrow--selected {
    border-color: var(--brand-blue);
  }

  .rrow__qty {
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
  }

  .qty {
    font-size: var(--fs-qty);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .rrow__unit {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-soft-3);
  }

  .rrow__main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .rrow__name {
    font-size: 13.5px;
    font-weight: 600;
  }

  .rrow__meta {
    color: var(--text-faint-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-meta);
  }

  .badge {
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-pill);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .badge--warn {
    background: var(--warn-bg);
    color: var(--warn-text);
  }

  .badge--info {
    background: var(--info-bg);
    color: var(--brand-blue-hover);
  }

  .badge--neutral {
    background: var(--neutral-badge-bg);
    color: var(--text-soft-3);
  }

  .empty {
    margin: var(--sp-5) 0;
    color: var(--text-faint-2);
    font-size: 13px;
  }

  /* -------------------------------------------------------- detail pane */

  .detail__name {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 800;
  }

  .detail__sku {
    margin: 0 0 var(--sp-4);
    color: var(--text-faint-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-meta);
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    padding: var(--sp-4);
    border-radius: var(--r-card);
    background: var(--surface-pale-blue-4);
  }

  .compare__label {
    margin: 0;
    color: var(--text-faint-2);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .compare__value {
    margin: var(--sp-1) 0 0;
    font-size: 30px;
  }

  .compare__cell--system .compare__value {
    color: var(--text-muted);
  }

  .compare__unit {
    margin: 0;
    color: var(--text-soft-3);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .diff {
    margin: var(--sp-2) 0 var(--sp-4);
    font-size: 12.5px;
    font-weight: 700;
  }

  .diff--ok {
    color: var(--ok);
  }

  .diff--warn {
    color: var(--warn);
  }

  .alert {
    padding: var(--sp-4);
    margin-bottom: var(--sp-4);
    border: 1.5px solid var(--warn-border-2);
    border-radius: var(--r-card);
    background: var(--warn-bg-2);
  }

  .alert__title {
    margin: 0 0 var(--sp-1);
    color: var(--warn-text);
    font-size: 13.5px;
    font-weight: 800;
  }

  .alert__detail {
    margin: 0;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .trace {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }

  .trace th,
  .trace td {
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--border-7);
    text-align: left;
    vertical-align: top;
  }

  .trace th {
    width: 44%;
    color: var(--text-soft-3);
    font-weight: 600;
  }

  .signed {
    margin-top: var(--sp-3);
    color: var(--text-soft-2);
    font-size: 12px;
  }

  .detail__actions {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .detail__actions .btn {
    height: var(--h-auditor-primary);
  }

  .detail__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
  }

  .detail__secondary .btn {
    height: var(--h-auditor-secondary);
  }

  .detail__note {
    margin: var(--sp-3) 0 0;
    color: var(--text-faint-2);
    font-size: 11.5px;
  }

  /* -------------------------------------------------------------- modal */

  .scrim {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--sp-5);
    background: var(--scrim);
    z-index: 10;
  }

  .modal {
    width: min(480px, 100%);
    padding: var(--sp-6);
    border-radius: var(--r-modal);
    background: var(--surface);
    animation: trise 0.2s ease both;
  }

  .modal__icon {
    font-family: var(--font-icon);
    font-size: 30px;
  }

  .modal__icon--warn {
    color: var(--warn);
  }

  .modal__icon--info {
    color: var(--brand-blue);
  }

  .modal__title {
    margin: var(--sp-2) 0 var(--sp-2);
    font-size: 19px;
    font-weight: 800;
  }

  .modal__body {
    margin: 0 0 var(--sp-4);
    color: var(--text-soft-2);
    font-size: 13.5px;
  }

  .modal__actions {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  .field {
    display: grid;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .field__label {
    color: var(--text-faint-2);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .field__input {
    padding: var(--sp-3);
    border: 1px solid var(--border-3);
    border-radius: var(--r-input);
    background: var(--surface-input);
  }
</style>
