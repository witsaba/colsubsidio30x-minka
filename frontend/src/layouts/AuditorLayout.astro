---
/**
 * Auditor shell — `/auditor` (design §4, §5).
 *
 * The design frame is 1194x834, an iPad Pro 11" in landscape, NOT a desktop
 * breakpoint. The three-pane review view is rigid by design (rail 94 +
 * warehouses 286 + records 1fr + detail 352), and the fluid `1fr` center is
 * what lets it scale up to a desktop without a second layout.
 *
 * Below 1024px the grid is replaced by a static notice rather than collapsed
 * into a broken stack. That is an accepted, flagged tradeoff: auditor phones
 * are out of scope, and a half-working three-pane review is worse than an
 * honest one-line instruction.
 *
 * Slots: `rail` (nav), `bodegas`, `registros`, `detalle`. The header row and
 * the interactive panes are provided by the caller / the AuditorReview island.
 */
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0067b1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {/*
      D12: same single Google Fonts CDN call as the operator shell. Tradeoff
      noted there: no build setup, but a third-party network dependency at demo
      time; the fallback stacks in tokens.css keep the dashboard readable.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300,0,0&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>

    {/*
      Rendered on every viewport; CSS decides which one is visible, so there is
      no layout shift and no client JS involved in the breakpoint decision.
    */}
    <p class="notice">Usa una tablet o un computador para la revisión</p>

    <div class="shell">
      <nav class="shell__rail" aria-label="Secciones del auditor">
        <slot name="rail" />
      </nav>

      <aside class="shell__bodegas" aria-label="Bodegas">
        <slot name="bodegas" />
      </aside>

      <main id="contenido" class="shell__registros">
        <slot name="registros" />
        <slot />
      </main>

      <aside class="shell__detalle" aria-label="Registro seleccionado">
        <slot name="detalle" />
      </aside>
    </div>
  </body>
</html>

<style>
  .notice {
    display: none;
    place-content: center;
    min-height: 100dvh;
    padding: var(--sp-6);
    text-align: center;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--text-soft-2);
    background: var(--page);
  }

  /* Below the tablet frame the three-pane grid is withheld, not collapsed. */
  @media (max-width: 1023.98px) {
    .notice {
      display: grid;
    }

    .shell {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .shell {
      display: grid;
      grid-template-columns: var(--auditor-rail) var(--auditor-warehouses) 1fr var(--auditor-detail);
      height: 100dvh;
      background: var(--app-bg-auditor);
    }
  }

  .shell__rail {
    background: var(--brand-blue);
    overflow-y: auto;
  }

  .shell__bodegas {
    background: var(--surface);
    border-right: 1px solid var(--border-5);
    overflow-y: auto;
  }

  .shell__registros {
    min-width: 0;
    overflow-y: auto;
  }

  .shell__detalle {
    background: var(--surface);
    border-left: 1px solid var(--border-5);
    overflow-y: auto;
  }

  /* Auditor scrollbars are visible, 6px with a #dcdcd4 thumb (contract §1). */
  .shell__bodegas::-webkit-scrollbar,
  .shell__registros::-webkit-scrollbar,
  .shell__detalle::-webkit-scrollbar,
  .shell__rail::-webkit-scrollbar {
    width: 6px;
  }

  .shell__bodegas::-webkit-scrollbar-thumb,
  .shell__registros::-webkit-scrollbar-thumb,
  .shell__detalle::-webkit-scrollbar-thumb,
  .shell__rail::-webkit-scrollbar-thumb {
    background: var(--border-4);
    border-radius: var(--r-pill);
  }
</style>
