# Copy to services/stt/.env and fill in. .env never enters git.

# --- vendor selection -------------------------------------------------------
# The only switch needed to change vendor: deepgram | groq (REQ-VND-3).
STT_VENDOR=deepgram

# Required when it is the ACTIVE vendor; the other one may stay empty.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Deepgram request parameters (REQ-VND-1) --------------------------------
STT_LANGUAGE=es          # es-CO scope: the dedicated Spanish model, never multi
STT_MODEL=nova-3
STT_NUMERALS=true
STT_MIP_OPT_OUT=true     # zero retention; verify the billed rate with a live key

# --- is_garbage policy (REQ-STT-3) ------------------------------------------
STT_CONFIDENCE_FLOOR=0.60
STT_MIN_SPEECH_MS=300

# --- limits and logging -----------------------------------------------------
# 1 MiB, aligned with Starlette's max_part_size and spool threshold so the
# upload never rolls over to disk (design Decision 6). Raising it means
# revisiting that coupling.
STT_MAX_UPLOAD_BYTES=1048576
STT_VENDOR_TIMEOUT_S=30
LOG_LEVEL=INFO
