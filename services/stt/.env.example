# Copy to services/stt/.env and fill in. .env never enters git.

# --- vendor selection -------------------------------------------------------
# The only switch needed to change vendor: deepgram | groq (REQ-VND-3).
STT_VENDOR=deepgram

# Only the ACTIVE vendor's key is required; the other one may stay empty (and
# compose no longer demands it, so a Groq-only deployment starts). Startup
# fails with a message naming the variable if the active vendor's key is unset.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Deepgram request parameters (REQ-VND-1) --------------------------------
STT_LANGUAGE=es          # es-CO scope: the dedicated Spanish model, never multi
STT_MODEL=nova-3
STT_NUMERALS=true
STT_MIP_OPT_OUT=true     # zero retention; verify the billed rate with a live key

# --- is_garbage policy (REQ-STT-3) ------------------------------------------
STT_CONFIDENCE_FLOOR=0.60
STT_MIN_SPEECH_MS=300

# --- limits and logging -----------------------------------------------------
# 1 MiB. The ASGI body guard in src/body_limit.py rejects anything larger with
# 413 before form parsing, and pins Starlette's spool threshold to the same
# limit, so the upload can never roll over to disk (design Decision 6).
STT_MAX_UPLOAD_BYTES=1048576
STT_VENDOR_TIMEOUT_S=30
LOG_LEVEL=INFO

# --- vendor resilience (REQ-VND-6, REQ-VND-7) --------------------------------
# Total attempts against the PRIMARY vendor, initial call included; 1 disables
# retry, 0 fails startup. Backoff doubles per attempt (0.5s, 1s, ...).
STT_RETRY_ATTEMPTS=2
STT_RETRY_BACKOFF_S=0.5
# Automatic failover to the other vendor after the primary is exhausted. Needs
# that vendor's key above to be set, otherwise it simply never fires.
STT_FALLBACK_ENABLED=true
# Ceiling on ALL vendor work for one request - every attempt, every backoff and
# the failover together. Must be > 0. Without it the settings above multiply
# out to 30 + 0.5 + 30 + 30 s of waiting before a 502.
STT_TOTAL_DEADLINE_S=45
