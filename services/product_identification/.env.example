# --- CONFIGURACIÓN DE GEMINI Y VERTEX AI ---

# Usar Vertex AI para consumir los $300 USD de crédito de Google Cloud
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=tu-id-de-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=ruta/a/tu/credencial-gcp.json

# API Keys como alternativa
GEMINI_API_KEY=tu_gemini_api_key
GOOGLE_CLOUD_API_KEY=tu_google_cloud_api_key

# Modelo por defecto
DEFAULT_MODEL=gemini-2.5-flash
