# Template for the single root .env that docker-compose.yml reads.
#
# Do not edit .env by hand unless you want to: `./scripts/setup-env.sh` walks
# every variable below, asks for it with this help text, hides secrets while
# you type, and keeps whatever you already answered.
#
# Never commit .env. It is git-ignored, and every value here is blank or a
# non-sensitive default on purpose.
#
# Adding a service? Add its variables here, each under a comment explaining
# it — the setup script and the deployment tests are driven by this file, so
# there is nothing else to change.

# ---------------------------------------------------------------------------
# stt — speech to text (http://localhost:8001)
# ---------------------------------------------------------------------------

# Deepgram API key. Required when STT_VENDOR=deepgram; otherwise it only needs
# a value if Deepgram should be reachable as a failover target.
DEEPGRAM_API_KEY=

# Groq API key. Required when STT_VENDOR=groq; otherwise optional, as above.
GROQ_API_KEY=

# ElevenLabs API key. Optional and backup-only: ElevenLabs may never be the
# primary vendor (its zero-retention guarantee is Enterprise-gated, RNF-04).
ELEVENLABS_API_KEY=

# Primary vendor every clip goes to: deepgram or groq.
STT_VENDOR=deepgram

# ElevenLabs Scribe model used when it is reached as a fallback: scribe_v1 or
# scribe_v2.
STT_ELEVENLABS_MODEL=scribe_v1

# Shortest clip worth sending to a vendor, in milliseconds. Anything below is
# rejected locally as garbage.
STT_MIN_SPEECH_MS=300

# Largest upload accepted, in bytes. 1 MiB, aligned with Starlette's spool
# threshold so the temporary file never rolls over to disk.
STT_MAX_UPLOAD_BYTES=1048576

# Timeout for a single vendor call, in seconds.
STT_VENDOR_TIMEOUT_S=30

# Total attempts against the primary vendor, the first call included. 1 means
# no retry.
STT_RETRY_ATTEMPTS=2

# Base backoff between primary attempts, in seconds. It doubles each time.
STT_RETRY_BACKOFF_S=0.5

# Fail over to another vendor once the primary is exhausted.
STT_FALLBACK_ENABLED=true

# Which vendor to fail over to. Blank walks the chain deepgram -> elevenlabs
# -> groq, skipping any vendor with no key. Naming one makes it the whole
# chain, and boot fails if it has no key.
STT_FALLBACK_VENDOR=

# Ceiling on all vendor work for one request: every attempt, every backoff and
# every failover together, in seconds.
STT_TOTAL_DEADLINE_S=45

# Log verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# matcher — product matching over the catalogue (http://localhost:8002)
# ---------------------------------------------------------------------------

# Score at or above which a candidate is accepted as a match, 0.0 to 1.0.
MATCH_ACCEPT_SCORE=0.50

# Minimum score gap between the top two candidates. Below it the result is
# reported as ambiguous instead of matched.
MATCH_AMBIGUITY_MARGIN=0.08

# Minimum score gap for the token-set-ratio tie-break.
MATCH_TSR_MARGIN=0.08

# How many candidates a match response may carry.
MATCH_MAX_CANDIDATES=5

# Re-rank candidates by the unit the operator spoke (litros, kilos, ...).
MATCH_UNIT_RERANK=true

# Attempts to load the catalogue at boot before the service gives up.
STARTUP_RETRIES=3

# Delay between catalogue load attempts, in seconds.
STARTUP_RETRY_DELAY_SECONDS=2.0

# ---------------------------------------------------------------------------
# product_identification — voice inventory extraction & Gemini (http://localhost:8003)
# ---------------------------------------------------------------------------

# Use Vertex AI for Google Cloud credit consumption (true/false).
USE_VERTEX_AI=true

# Google Cloud Project ID.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0715489298

# Google Cloud Location / Region.
GOOGLE_CLOUD_LOCATION=us-central1

# Google Application Credentials JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=gen-lang-client-0715489298-735dd2d08718.json

# Gemini API Key (alternative authentication method).
GEMINI_API_KEY=

# Google Cloud API Key (Express Mode).
GOOGLE_CLOUD_API_KEY=

# Default Gemini model used by the microservice.
DEFAULT_MODEL=gemini-2.5-flash

