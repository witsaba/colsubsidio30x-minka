# The single root env file. Vendor credentials never enter git; .env.example
# is the committed template and ./scripts/setup-env.sh fills this in.
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.coverage

# Local tool state
.codegraph/
.atl/

# Frontend (Astro)
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Secrets. `services/stt/.env` holds DEEPGRAM_API_KEY; nothing named .env is
# ever committed. The `.env.example` files ARE tracked — they carry key NAMES
# and safe localhost defaults, never values.
.env
.env.*
!.env.example
!*.env.example

# Service-account credentials (product_identification / Vertex AI).
gen-lang-client-*.json
*-key.json
service-account*.json
