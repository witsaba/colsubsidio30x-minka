# The single root env file. Vendor credentials never enter git; .env.example
# is the committed template and ./scripts/setup-env.sh fills this in.
# `.env.*` and the negations keep every `.env.example` template tracked
# (root, and any per-service one) while nothing named `.env` ever is.
.env
.env.*
!.env.example
!*.env.example

# Local test database dump / workspace (operator-only scratch).
BD_Pruebas/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.coverage

# Local tool state
.codegraph/
.atl/

# Frontend (Astro)
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Service-account credentials (product_identification / Vertex AI).
gen-lang-client-*.json
*-key.json
key-gcp.json
service-account*.json
