# The single root env file. Vendor credentials never enter git; .env.example
# is the committed template and ./scripts/setup-env.sh fills this in.
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.coverage

# Local tool state
.codegraph/
.atl/

# Environment and Credentials (Local preservation, ignored by Git)
.env
.env.*
!.env.example
gen-lang-client-*.json
*-key.json
key-gcp.json
service-account*.json

